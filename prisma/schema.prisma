generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Banker {
  id           Int             @id @default(autoincrement())
  username     String          @unique
  passwordHash String
  bankName     String
  createdAt    DateTime        @default(now())
  users        User[]
  settings     BankerSettings?
}

model BankerSettings {
  id                 Int    @id @default(autoincrement())
  bankerId           Int    @unique
  banker             Banker @relation(fields: [bankerId], references: [id], onDelete: Cascade)
  annualInterestRate Float  @default(0.0500)
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  passwordHash String
  colorTheme   String   @default("sky")
  bankerId     Int
  banker       Banker   @relation(fields: [bankerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  account      Account?
}

model Account {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique
  currentBalance Float         @default(0.00)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
}

model Transaction {
  id          Int      @id @default(autoincrement())
  accountId   Int
  date        DateTime
  amount      Float
  type        String
  description String   @default("")
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
